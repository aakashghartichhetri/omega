{$OMEGA_SITE_ADDRESS} {
    encode gzip zstd

    @api path /api/*
    handle @api {
        reverse_proxy backend:8000
    }

    @docs path /docs /openapi.json /redoc
    handle @docs {
        reverse_proxy backend:8000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        -Server
    }
}
