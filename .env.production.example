# Copy to .env.production, edit, and NEVER commit the new file.
# Choose a real DNS name whose A/AAAA record points at your server.
OMEGA_SITE_ADDRESS=omega.example.com
POSTGRES_USER=omega
# Use a long, random URL-safe password: letters, digits, underscore, dash.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=omega
# Long, independent random key. Visitors enter this in the dashboard header.
OMEGA_API_KEY=REPLACE_WITH_A_LONG_RANDOM_API_KEY
