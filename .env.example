# Local development only. Change credentials before any shared deployment.
POSTGRES_USER=omega
POSTGRES_PASSWORD=omega
POSTGRES_DB=omega
# PostgreSQL is internal-only; use docker compose exec database psql to connect.
# Host port for the backend; container health checks and the frontend proxy still use backend:8000.
OMEGA_API_HOST_PORT=8001
# For running the backend outside Docker, you need a separate reachable PostgreSQL server.
# DATABASE_URL=postgresql+psycopg://omega:omega@localhost:5432/omega
# OMEGA_ENGINE_PATH=/absolute/path/to/rust-engine/target/release/omega-engine

# Optional in local development; set a long random value for protected access.
# Enter this key under API access in the left navigation (held only in browser memory).
OMEGA_API_KEY=
